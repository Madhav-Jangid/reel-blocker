<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Narrow permission surface, per need.md section 10: no VPN, contacts, SMS,
         microphone or notification-reading access. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the user exempt ReelLock from battery-optimization process
         killing, via the system's own confirmation dialog (requested
         explicitly in the setup flow, never silently). This is the actual
         mechanism behind "let it run in the background" - narrowly used for
         exactly that, not a general always-on-in-background grab. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lets the accessibility service query whether a monitored app is
         installed (android 11+ package visibility rules). -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.youtube" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

    <application
        android:label="ReelLock"
        android:name=".ReelLockApplication"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller (OpenGLES) hits a black-screen bug on some emulator GPU
             drivers (seen here: "Width is zero" / 1.6s Davey frames /
             Mesa virtgpu property-denied warnings in logcat). Falls back to
             the older, more stable Skia renderer. Safe to remove once this
             is confirmed fine on a real device. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- Keeps this process alive past the app's UI task being swiped from
             Recents, so the accessibility service below doesn't get killed
             with it - see monitoring/ReelLockForegroundService.kt. -->
        <service
            android:name=".monitoring.ReelLockForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitoring short-form video usage to enforce a user-configured digital wellbeing limit" />
        </service>

        <!-- Detection core: see accessibility/ReelLockAccessibilityService.kt -->
        <service
            android:name=".accessibility.ReelLockAccessibilityService"
            android:exported="false"
            android:label="ReelLock Short-Video Detection"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Device-owner / device-admin policy hook for Managed mode, see
             deviceadmin/ReelLockDeviceAdminReceiver.kt. No-op unless provisioned. -->
        <receiver
            android:name=".deviceadmin.ReelLockDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".monitoring.BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
